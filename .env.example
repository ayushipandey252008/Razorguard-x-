# RazorGuard X — environment template
# Copy to .env and adjust. Never commit secrets.

# --- App ---
APP_NAME=RazorGuard X
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local Docker Compose:
DATABASE_URL=postgresql+asyncpg://razorguard:razorguard@localhost:5432/razorguard
# SQLite fallback for tests / no-Postgres local runs:
# DATABASE_URL=sqlite+aiosqlite:///./razorguard.db

# --- Redis (optional; in-memory pub/sub used if unreachable) ---
REDIS_URL=redis://localhost:6379/0

# --- Risk engine ---
# Combined 0–100 score. THRESHOLD_* are configurable, not industry-standard.
WEIGHT_ML=0.35
WEIGHT_BEHAVIOR=0.20
WEIGHT_RULES=0.25
WEIGHT_GRAPH=0.20
THRESHOLD_REVIEW=40
THRESHOLD_BLOCK=70
# Relative cost units for the synthetic threshold experiment (ml/evaluation/threshold_calibration.md)
COST_FALSE_POSITIVE=10
COST_FALSE_NEGATIVE=100
COST_REVIEW=2

# --- LLM agent (leave empty / LLM_PROVIDER=none to use the deterministic fallback) ---
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=

# Prototype graph-ring heuristics (not production-grade)
GRAPH_MIN_CLUSTER_USERS=3
GRAPH_SHARED_DEVICE_ACCOUNTS=3
GRAPH_SHARED_IP_ACCOUNTS=3
GRAPH_FLAGGED_PATH_MAX_HOPS=2
GRAPH_DENSE_SUBGRAPH_MIN_DENSITY=0.6
GRAPH_SUSPICIOUS_ENTITY_DEGREE=3

# Graph store: networkx (default, no extra services) or neo4j (optional persistence)
GRAPH_BACKEND=networkx
GRAPH_NEO4J_FALLBACK=true
GRAPH_REBUILD_ON_START=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Domain event bus: inprocess (default) or kafka. Kafka is optional.
EVENT_BUS=inprocess
EVENT_BUS_FALLBACK=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_TIMEOUT_SECONDS=15
KAFKA_PUBLISH_TIMEOUT_MS=5000
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_RISK_RESULTS=risk-results
KAFKA_TOPIC_INVESTIGATIONS=investigations
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_FEEDBACK=feedback
KAFKA_TOPIC_DLQ=events-dlq
KAFKA_GROUP_TRANSACTIONS=rgx-transactions
KAFKA_GROUP_RISK=rgx-risk-results
KAFKA_GROUP_INVESTIGATIONS=rgx-investigations
KAFKA_GROUP_ALERTS=rgx-alerts
KAFKA_GROUP_FEEDBACK=rgx-feedback
EVENT_ALERT_ON_BLOCK=true
EVENT_ALERT_ON_REVIEW=true

# Transactional outbox (Phase 6). Kafka is still optional.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_SECONDS=1
OUTBOX_STALE_PROCESSING_SECONDS=30
OUTBOX_DRAIN_AFTER_COMMIT=true
OUTBOX_BACKGROUND_WORKER=true

# Phase 7 monitoring (prototype PSI thresholds, not production standards)
DRIFT_PSI_LOW=0.10
DRIFT_PSI_HIGH=0.25
DRIFT_MIN_SAMPLES=20
DRIFT_ALERT_COOLDOWN_SECONDS=3600
FEEDBACK_MIN_TRAIN_ROWS=12

# IEEE-CIS offline track (never auto-downloaded, never live)
IEEE_DATA_DIR=ml/data/ieee
# IEEE_MAX_ROWS=50000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Demo seed accounts (used only by scripts/seed.py) ---
SEED_ADMIN_EMAIL=admin@razorguard.local
SEED_ADMIN_PASSWORD=prototype-pass
