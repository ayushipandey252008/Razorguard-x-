# --- Offline / generated model binaries (reproducible; do not replace live) ---
ml/models/ulb/*.joblib
ml/models/ieee/**/*.joblib
ml/models/feedback/**
!ml/models/feedback/.gitkeep
!ml/models/feedback/README.md

# Live product artifacts under ml/models/ are committed (small, required to run the API).
# Do not add other large joblibs at the live root.
